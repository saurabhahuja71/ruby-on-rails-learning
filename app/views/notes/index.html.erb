<h1>Notes</h1>

<p><%= link_to "New note", new_note_path, class: "btn btn-primary" %></p>

<% if @notes.any? %>
  <div class="grid">
    <% @notes.each do |note| %>
      <article class="card">
        <h2><%= link_to note.title, note %></h2>
        <p class="muted"><%= time_ago_in_words(note.created_at) %> ago · <%= pluralize note.comments.size, "comment" %></p>
        <p><%= truncate(note.body, length: 120) %></p>
        <p><%= link_to "Read", note, class: "btn" %> <%= link_to "Edit", edit_note_path(note), class: "btn" %></p>
      </article>
    <% end %>
  </div>
<% else %>
  <p>No notes yet. Create your first one!</p>
<% end %>
